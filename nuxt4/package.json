{
  "name": "shirone-nuxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-content.mjs && nuxt dev --port 4322",
    "build": "node scripts/build-content.mjs && nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write app server shared tests nuxt.config.ts",
    "content:build": "node scripts/build-content.mjs"
  },
  "dependencies": {
    "@expressive-code/core": "0.44.2",
    "@expressive-code/plugin-collapsible-sections": "0.44.2",
    "@expressive-code/plugin-frames": "0.44.2",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "@expressive-code/plugin-shiki": "0.44.2",
    "@fancyapps/ui": "6.1.15",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@iconify-json/material-symbols": "1.2.92",
    "@iconify-json/simple-icons": "1.2.95",
    "@material/material-color-utilities": "0.4.0",
    "@tailwindcss/vite": "4.3.3",
    "dompurify": "3.3.3",
    "gray-matter": "4.0.3",
    "hast-util-from-html": "2.0.3",
    "hastscript": "9.0.1",
    "katex": "0.16.47",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "11.17.2",
    "nuxt": "4.5.2",
    "pagefind": "1.5.2",
    "path-browserify": "1.0.1",
    "qrcode": "1.5.4",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-components": "0.3.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "3.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-sectionize": "2.1.0",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.4",
    "stylus": "0.64.0",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.5.1",
    "fontverter": "2.0.0",
    "prettier": "3.7.4",
    "subset-font": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-tsc": "3.2.5"
  }
}
