  "site": {
    "site": "https://shirone.mysqil.com/",
    "base": "/",
    "title": "Shirone",
    "subtitle": "记录技术探索与生活片段的个人博客",
    "topAppBar": {
      "contentAlign": "center"
    },
    "displaySettings": {
      "colorStyle": true,
      "colorSpec": true,
      "wallpaperMode": true,
      "layoutMode": true,
      "reduceMotion": true,
      "texture": true
    },
    "lang": "zh_CN",
    "timeZone": "Asia/Shanghai",
    "themeColor": {
      "hue": 315,
      "fixed": false,
      "style": "tonalSpot",
      "spec": "2025"
    },
    "wallpaperMode": {
      "defaultMode": "banner"
    },
    "texture": {
      "enable": true,
      "defaultPreset": "starlight",
      "defaultOpacity": 0.12,
      "allowMotion": true
