        ],
        "mobile": [
          "assets/images/banner/mobile/1.webp"
        ]
      },
      "position": "center",
      "dim": {
        "enable": true,
        "opacity": 0.24
      },
      "homeText": {
        "enable": true,
        "title": "Shirone",
        "subtitle": [
          "把平凡的日子，写成值得珍藏的故事。",
          "在代码与文字之间，慢慢找到自己的节奏。",
          "记录每一次好奇，也记录每一份热爱。",
          "愿今天的灵感，成为明天的小小进步。",
          "你好，欢迎来到我的数字小天地。"
        ],
        "typewriter": {
          "enable": true,
          "speed": 100,
          "deleteSpeed": 50,
          "pauseTime": 2000,
          "loop": true
        }
      },
      "carousel": {
        "enable": true,
        "interval": 6000,
        "fadeDuration": 1200,
        "animation": "ken-burns"
      },
      "waves": {
        "enable": true
      }
    },
    "imageOptimization": {
      "noReferrerDomains": [
        "*.hdslb.com"
      ]
    },
    "toc": {
      "enable": true,
      "depth": 2
    },
    "progressIndicator": {
